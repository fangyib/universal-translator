# LLM provider: mock (dev) | cntokenworld | openai | custom
LLM_PROVIDER=cntokenworld

# 词元天下 — 在控制台获取 API Key，勿提交到 git
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://www.cntokenworld.com/api/aistore/v1
LLM_MODEL=neice-glm5.1
LLM_TIMEOUT_SECONDS=90

# CORS — frontend dev server origins
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5180
